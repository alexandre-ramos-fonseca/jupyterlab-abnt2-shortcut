{
  "name": "jupyterlab-abnt2-shortcut",
  "version": "0.1.0",
  "description": "Restore Ctrl+/ for Brazilian ABNT2 keyboards in JupyterLab CodeMirror editors.",
  "license": "MIT",
  "author": "Alexandre Ramos Fonseca",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "abnt2",
    "codemirror"
  ],
  "files": [
    "lib/**/*",
    "static/**/*"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "jupyterlab": {
    "extension": true
  },
  "scripts": {
    "build": "yarn build:lib && yarn build:labextension",
    "build:lib": "tsc -b",
    "build:labextension": "jupyter labextension build . --development=True",
    "typecheck": "tsc --noEmit",
    "clean": "yarn clean:lib",
    "clean:lib": "yarn dlx rimraf lib tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@jupyterlab/application": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": ">=4.0.0 <5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3"
  },
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=18.18.0"
  }
}
